rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function householdDocPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function householdInvitePath(inviteCode) {
      return /databases/$(database)/documents/householdInvites/$(inviteCode);
    }

    function isHouseholdOwner(householdId) {
      return isSignedIn() &&
        get(householdDocPath(householdId)).data.ownerUid == request.auth.uid;
    }

    function isHouseholdOwnerAfter(householdId) {
      return isSignedIn() &&
        getAfter(householdDocPath(householdId)).data.ownerUid == request.auth.uid;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function itemAllowedFields() {
      return [
        'name',
        'remainingCount',
        'receivedDate',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy',
      ];
    }

    function isValidItemName(name) {
      return name is string &&
        name.size() >= 1 &&
        name.size() <= 100;
    }

    function isValidReceivedDate(date) {
      return date is string &&
        date.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidRemainingCountForCreate(count) {
      return count is int && count >= 1 && count <= 99;
    }

    function isValidRemainingCountForUpdate(count) {
      return count is int && count >= 0 && count <= 99;
    }

    function hasRequiredItemFields(data) {
      return data.keys().hasAll(itemAllowedFields());
    }

    function hasOnlyAllowedItemFields(data) {
      return data.keys().hasOnly(itemAllowedFields());
    }

    function isValidItemCommonFields(data) {
      return isValidItemName(data.name) &&
        isValidReceivedDate(data.receivedDate) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.createdBy is string &&
        data.updatedBy is string;
    }

    function isValidItemCreate(data) {
      return hasRequiredItemFields(data) &&
        hasOnlyAllowedItemFields(data) &&
        isValidItemCommonFields(data) &&
        isValidRemainingCountForCreate(data.remainingCount) &&
        data.createdBy == request.auth.uid &&
        data.updatedBy == request.auth.uid &&
        data.createdBy == data.updatedBy &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidItemUpdate() {
      return hasRequiredItemFields(request.resource.data) &&
        hasOnlyAllowedItemFields(request.resource.data) &&
        isValidItemCommonFields(request.resource.data) &&
        isValidRemainingCountForUpdate(request.resource.data.remainingCount) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidUserData(data) {
      return data.keys().hasOnly(['currentHouseholdId', 'householdIds']) &&
        (data.currentHouseholdId == null || data.currentHouseholdId is string) &&
        data.householdIds is list;
    }

    function isValidMemberJoin(householdId, uid, data) {
      return isSignedIn() &&
        uid == request.auth.uid &&
        data.keys().hasAll(['uid', 'role', 'displayName', 'email', 'joinedAt', 'invitedBy', 'inviteCode']) &&
        data.keys().hasOnly(['uid', 'role', 'displayName', 'email', 'joinedAt', 'invitedBy', 'inviteCode']) &&
        data.uid == request.auth.uid &&
        data.role == 'member' &&
        data.displayName is string &&
        data.email is string &&
        data.joinedAt == request.time &&
        data.invitedBy is string &&
        data.inviteCode is string &&
        exists(householdInvitePath(data.inviteCode)) &&
        get(householdInvitePath(data.inviteCode)).data.householdId == householdId &&
        get(householdInvitePath(data.inviteCode)).data.expiresAt > request.time;
    }

    function isValidInviteCreate(data) {
      return data.keys().hasOnly(['householdId', 'createdBy', 'createdAt', 'expiresAt']) &&
        data.householdId is string &&
        data.createdBy == request.auth.uid &&
        data.createdAt == request.time &&
        data.expiresAt is timestamp &&
        data.expiresAt > request.time;
    }

    match /users/{uid} {
      allow read: if isCurrentUser(uid);
      allow create, update: if isCurrentUser(uid) && isValidUserData(request.resource.data);
    }

    match /householdInvites/{inviteCode} {
      allow create: if isSignedIn() &&
        isValidInviteCreate(request.resource.data) &&
        isHouseholdOwner(request.resource.data.householdId);
      allow read: if isSignedIn() && resource.data.expiresAt > request.time;
      allow delete: if isSignedIn() && isHouseholdOwner(resource.data.householdId);
    }

    match /households/{householdId} {
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow read: if isHouseholdMember(householdId) ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if (isHouseholdMember(householdId) ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid)) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isHouseholdOwner(householdId);

      match /members/{uid} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdOwner(householdId) ||
          isHouseholdOwnerAfter(householdId) ||
          isValidMemberJoin(householdId, uid, request.resource.data);
        allow update: if isHouseholdOwner(householdId);
        allow delete: if isHouseholdOwner(householdId) ||
          (isSignedIn() && request.auth.uid == uid);
      }

      match /items/{itemId} {
        allow read, delete: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) &&
          isValidItemCreate(request.resource.data);
        allow update: if isHouseholdMember(householdId) &&
          isValidItemUpdate();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
