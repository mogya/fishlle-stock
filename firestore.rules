rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function householdDocPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function isHouseholdOwner(householdId) {
      return isSignedIn() &&
        get(householdDocPath(householdId)).data.ownerUid == request.auth.uid;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /households/{householdId} {
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow read: if isHouseholdMember(householdId) ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if (isHouseholdMember(householdId) ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid)) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isHouseholdOwner(householdId);

      match /members/{uid} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdOwner(householdId) ||
          (
            isSignedIn() &&
            uid == request.auth.uid &&
            getAfter(householdDocPath(householdId)).data.ownerUid == request.auth.uid
          );
        allow update: if isHouseholdOwner(householdId);
        allow delete: if isHouseholdOwner(householdId) ||
          (isSignedIn() && request.auth.uid == uid);
      }

      // TODO: データモデル確定後に hasOnlyAllowedFields 相当の検証と文字列長制限（リポジトリ内の .agents/skills/firebase-firestore/references/standard/security_rules.md にあるガイドライン）を追加することを推奨
      match /items/{itemId} {
        allow read, create, update, delete: if isHouseholdMember(householdId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
