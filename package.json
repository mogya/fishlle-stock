{
  "name": "fishlle-stock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "scrape:recipes": "node scripts/scrape-recipes.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:firestore": "firebase deploy --only firestore",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck:rules": "tsc -p tsconfig.rules.json --noEmit",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:emulator": "firebase emulators:exec --project fishlle-stock-mogya --only firestore \"npm run test:rules\""
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-tools": "^15.25.1",
    "jsdom": "^30.0.1",
    "linkedom": "^0.18.13",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
